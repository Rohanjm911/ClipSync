.gradle/
build/
flutter_app/build/
flutter_app/.dart_tool/
android/app/build/
android/.gradle/
local.properties
*.apk
!clipsync-android.apk
*.aab
*.dex

# Tauri build artifacts
src-tauri/target/
windows/src-tauri/target/

# IDE & Editor caches
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & Environment
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.env
.env.local
.env.*.local
